{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the small windows (FPS window, widget, boost prompt)",
  "windows": ["main", "overlay", "widget", "prompt"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
